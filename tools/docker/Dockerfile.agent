# Build stage
FROM golang:1.26-alpine AS builder
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -mod=vendor -ldflags="-s -w" -o /bin/agent ./cmd/agent

# Runtime stage
FROM gcr.io/distroless/base-nossl-debian13:nonroot
COPY --from=builder /bin/agent /agent
USER nonroot:nonroot
ENTRYPOINT ["/agent"]
