# Build stage
FROM golang:1.27-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/bff ./cmd/bff

# Runtime stage
FROM gcr.io/distroless/base-nossl-debian13:nonroot
COPY --from=builder /bin/bff /bff
USER nonroot:nonroot
ENTRYPOINT ["/bff"]
