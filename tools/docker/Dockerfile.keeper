# Build stage
FROM golang:1.27-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/keeper ./cmd/keeper

# Runtime stage
FROM gcr.io/distroless/base-nossl-debian13:nonroot
COPY --from=builder /bin/keeper /keeper
COPY --from=builder /src/deploy /app/deploy
USER nonroot:nonroot
ENTRYPOINT ["/keeper"]
