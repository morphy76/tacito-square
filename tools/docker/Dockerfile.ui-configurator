# Stage 1: Build the React 19 SPA
FROM node:26-alpine AS ui-builder
WORKDIR /app
COPY ui/configurator/package*.json ./ui/configurator/
RUN cd ui/configurator && npm install
COPY ui/configurator/ ./ui/configurator/
COPY ui/shared/ ./ui/shared/
RUN cd ui/configurator && npm run build

# Stage 2: Compile a lightweight Go static server to comply with the Distroless runtime constraint
FROM golang:1.27-alpine AS go-builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o static-server ./cmd/ui-server

# Stage 3: Package into final secure Distroless container
FROM gcr.io/distroless/base-nossl-debian13:nonroot
WORKDIR /app
COPY --from=go-builder /app/static-server /app/static-server
COPY --from=ui-builder /app/ui/configurator/dist /app/dist
ENV PORT=8080
ENV STATIC_DIR=/app/dist
EXPOSE 8080
ENTRYPOINT ["/app/static-server"]
