{
  "openapi": "3.0.3",
  "info": {
    "title": "Keeper API",
    "description": "API spec for Tacito Square Keeper component, managing agent configurations, communities, and support entities.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Primary API Version 1"
    }
  ],
  "paths": {
    "/llm-bindings": {
      "post": {
        "summary": "Create a new LLM provider binding",
        "operationId": "createLLMBinding",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLLMBindingRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successfully created LLM provider binding",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LLMBinding"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request / Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List all LLM provider bindings",
        "operationId": "listLLMBindings",
        "responses": {
          "200": {
            "description": "List of LLM provider bindings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LLMBinding"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/llm-bindings/{id}": {
      "get": {
        "summary": "Retrieve a specific LLM provider binding by ID",
        "operationId": "getLLMBinding",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The UUID of the LLM binding",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "LLM provider binding details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LLMBinding"
                }
              }
            }
          },
          "404": {
            "description": "LLM provider binding not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update an LLM provider binding by ID",
        "operationId": "updateLLMBinding",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The UUID of the LLM binding",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateLLMBindingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully updated LLM provider binding",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LLMBinding"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request / Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "LLM provider binding not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete an LLM provider binding by ID",
        "operationId": "deleteLLMBinding",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The UUID of the LLM binding",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successfully deleted LLM provider binding"
          },
          "404": {
            "description": "LLM provider binding not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/mcp-servers": {
      "post": {
        "summary": "Register a new MCP server profile",
        "operationId": "createMCPServer",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMCPServerRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successfully registered MCP server profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MCPServer"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request / Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List registered MCP server profiles",
        "operationId": "listMCPServers",
        "responses": {
          "200": {
            "description": "List of MCP server profiles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MCPServer"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/mcp-servers/{id}": {
      "get": {
        "summary": "Retrieve a specific MCP server profile by ID",
        "operationId": "getMCPServer",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The UUID of the MCP server configuration",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "MCP server configuration details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MCPServer"
                }
              }
            }
          },
          "404": {
            "description": "MCP server profile not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update an MCP server profile by ID",
        "operationId": "updateMCPServer",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The UUID of the MCP server configuration",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMCPServerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully updated MCP server profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MCPServer"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request / Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "MCP server profile not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Unregister an MCP server profile by ID",
        "operationId": "deleteMCPServer",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The UUID of the MCP server configuration",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successfully deleted MCP server profile"
          },
          "404": {
            "description": "MCP server profile not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateLLMBindingRequest": {
        "type": "object",
        "required": [
          "name",
          "provider",
          "api_base_url",
          "api_key_secret_ref",
          "default_model"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "openai-gpt4o"
          },
          "description": {
            "type": "string",
            "example": "Primary OpenAI GPT-4o endpoint"
          },
          "provider": {
            "type": "string",
            "enum": ["openai", "anthropic", "groq", "ollama", "custom"],
            "example": "openai"
          },
          "api_base_url": {
            "type": "string",
            "format": "uri",
            "example": "https://api.openai.com/v1"
          },
          "api_key_secret_ref": {
            "type": "string",
            "example": "openai-api-key"
          },
          "default_model": {
            "type": "string",
            "example": "gpt-4o"
          },
          "default_temperature": {
            "type": "number",
            "format": "double",
            "minimum": 0.0,
            "maximum": 2.0,
            "default": 0.7,
            "example": 0.7
          },
          "default_max_tokens": {
            "type": "integer",
            "minimum": 1,
            "default": 2048,
            "example": 2048
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "default": 30,
            "example": 30
          }
        }
      },
      "UpdateLLMBindingRequest": {
        "type": "object",
        "required": [
          "name",
          "provider",
          "api_base_url",
          "api_key_secret_ref",
          "default_model"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "openai-gpt4o"
          },
          "description": {
            "type": "string",
            "example": "Primary OpenAI GPT-4o endpoint"
          },
          "provider": {
            "type": "string",
            "enum": ["openai", "anthropic", "groq", "ollama", "custom"],
            "example": "openai"
          },
          "api_base_url": {
            "type": "string",
            "format": "uri",
            "example": "https://api.openai.com/v1"
          },
          "api_key_secret_ref": {
            "type": "string",
            "example": "openai-api-key"
          },
          "default_model": {
            "type": "string",
            "example": "gpt-4o"
          },
          "default_temperature": {
            "type": "number",
            "format": "double",
            "minimum": 0.0,
            "maximum": 2.0,
            "default": 0.7,
            "example": 0.7
          },
          "default_max_tokens": {
            "type": "integer",
            "minimum": 1,
            "default": 2048,
            "example": 2048
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "default": 30,
            "example": 30
          }
        }
      },
      "LLMBinding": {
        "type": "object",
        "required": [
          "id",
          "name",
          "provider",
          "api_base_url",
          "api_key_secret_ref",
          "default_model",
          "default_temperature",
          "default_max_tokens",
          "timeout_seconds",
          "status",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": ["openai", "anthropic", "groq", "ollama", "custom"]
          },
          "api_base_url": {
            "type": "string",
            "format": "uri"
          },
          "api_key_secret_ref": {
            "type": "string"
          },
          "default_model": {
            "type": "string"
          },
          "default_temperature": {
            "type": "number",
            "format": "double"
          },
          "default_max_tokens": {
            "type": "integer"
          },
          "timeout_seconds": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": ["active", "suspended", "inactive"]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateMCPServerRequest": {
        "type": "object",
        "required": [
          "name",
          "transport"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "sqlite-mcp"
          },
          "description": {
            "type": "string",
            "example": "Local SQLite MCP server"
          },
          "transport": {
            "type": "string",
            "enum": ["stdio", "sse"],
            "example": "stdio"
          },
          "command": {
            "type": "string",
            "example": "mcp-sqlite"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["--db", "test.db"]
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "example": {"DEBUG": "true"}
          },
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://mcp.github.com/events"
          },
          "auth_secret_ref": {
            "type": "string",
            "example": "github-secret"
          }
        }
      },
      "UpdateMCPServerRequest": {
        "type": "object",
        "required": [
          "name",
          "transport"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "sqlite-mcp"
          },
          "description": {
            "type": "string",
            "example": "Local SQLite MCP server"
          },
          "transport": {
            "type": "string",
            "enum": ["stdio", "sse"],
            "example": "stdio"
          },
          "command": {
            "type": "string",
            "example": "mcp-sqlite"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["--db", "test.db"]
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "example": {"DEBUG": "true"}
          },
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://mcp.github.com/events"
          },
          "auth_secret_ref": {
            "type": "string",
            "example": "github-secret"
          }
        }
      },
      "MCPServer": {
        "type": "object",
        "required": [
          "id",
          "name",
          "transport",
          "status",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "transport": {
            "type": "string",
            "enum": ["stdio", "sse"]
          },
          "command": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "auth_secret_ref": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["active", "suspended", "inactive"]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string",
            "example": "name is required"
          }
        }
      }
    }
  }
}
